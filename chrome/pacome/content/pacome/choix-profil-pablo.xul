<?xml version="1.0"?>

<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>
<?xml-stylesheet href="chrome://pacome/content/pacome.css" type="text/css"?>

<?xul-overlay href="chrome://courrielleur/content/ministeresOverlay.xul"?>

<!DOCTYPE window SYSTEM "chrome://pacome/locale/pacome.dtd">

<window title="&migrationPablo-Titre;"
        class="pacome"
        xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
				onload="InitChoixProfil();">

	<script type="application/x-javascript" src="chrome://pacome/content/pacomeutils.js"/>
	<script type="application/x-javascript" src="chrome://pacome/content/choix-profil-pablo.js"/>
		
  <vbox id="bandeau" class="bandeau">
    <description id="bandeau-titre" class="bandeau-titre">&migrationPablo-bandeau;</description>
  </vbox>

  <popupset id="tooltip_comptes"/>

  <!-- espace central -->
  <vbox id="pacome_zone" flex="1" class="pacome_zone">
	
		<separator/>
		
		<description class="pacometexte">&migrationPablo.choixProfil.texte1;</description>
		
		<description class="pacometexte">&migrationPablo.choixProfil.texte2;</description>
	
		<!-- liste des profils pablo -->
    <groupbox flex="1">
      <caption label="Profils Pablo"/>
      <listbox id="profils" rows="4" flex="3"/>
    </groupbox>
		
	</vbox>
	
  <hbox class="pacome_zone">
    <vbox id="infosapropos" flex="1"/>
  </hbox>

  <menuseparator/>	
	
  <hbox align="right">
		<button label="Valider" oncommand="mceValideProfil();"/>
    <button label="Ignorer" oncommand="mceIgnorerProfil();"/>
  </hbox>
</window>
